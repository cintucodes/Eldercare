<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivActivityIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/baseline_monitor_heart_24"
        android:contentDescription="Activity Icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActivityValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="72 bpm"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvActivityTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today 14:32"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/vStatusDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:background="@drawable/circle_indicator" />

</LinearLayout>
